<section id="v2-check-in" class="capacity-v2-check-in" aria-label="Daily measures and protocols" inert>
  <form id="v2-entry-form" class="capacity-v2-form">
    <section class="form-section">
      <h3>Daily measures</h3>
      <label class="field-label">Physical fatigue (0-10)<span class="field-helper">0 = no fatigue · 10 = extreme fatigue</span><input name="physicalFatigue" type="number" min="0" max="10" step="1" /></label>
      <label class="field-label">Cognitive difficulty (0-10)<span class="field-helper">Brain fog or swimming head · 0 = none · 10 = severe difficulty</span><input name="cognitiveDifficulty" type="number" min="0" max="10" step="1" /></label>
      <label class="field-label">How much did this affect what I could manage today?<select name="functionalImpact"><option value="">Not answered</option><option>No impact</option><option>Managed with extra effort</option><option>Reduced or postponed activities</option><option>Unable to manage essential activities</option></select></label>
      <details class="optional-details" data-optional-note><summary>Add a check-in note</summary><label class="field-label">Check-in notes<textarea name="notes" rows="2"></textarea></label></details>
    </section>

    <section class="form-section">
      <div class="capacity-section-heading"><h3>Protocols</h3></div>
      <details class="optional-details"><summary>Protocol details</summary>
<p><strong>BioLight full-spectrum light therapy</strong> — Record the time you actually used it, approximately 44 cm from the panel.</p>
<p><strong>BioLight infrared session</strong> — Following full-spectrum exposure.</p>
<p><strong>Vagustim V2 Standard cognitive programme</strong> — Approximately 15 minutes during the day, with flexible timing.</p>
<p><strong>Vagustim V2 Standard AI programme</strong> — Approximately 15 minutes before sleep. The important outcome is the subsequent night's sleep.</p>
<p>Tick a session only when completed. A day without a check-in stays unknown.</p></details>
      <label class="check-row"><input name="bioLightFullSpectrum" type="checkbox" /><span><strong>BioLight full-spectrum</strong></span></label>
      <label class="field-label compact-field" data-show-for="bioLightFullSpectrum" hidden>BioLight session length<select name="bioLightDurationMinutes"><option value="">Not recorded</option><option value="10">10 minutes</option><option value="20">20 minutes</option><option value="40">40 minutes</option><option value="60">1 hour</option></select></label>
      <label class="field-label" data-effect-for="bioLightFullSpectrum">Any noticeable effect afterwards?<select name="bioLightEffect"><option value="">Not answered</option><option>Noticeably better</option><option>Slightly better</option><option>No noticeable change</option><option>Felt worse</option><option>Not sure</option></select></label>
      <label class="check-row"><input name="bioLightInfrared" type="checkbox" /><span><strong>BioLight infrared</strong></span></label>
      <label class="check-row"><input name="vagustimDaytime" type="checkbox" /><span><strong>Vagustim daytime</strong></span></label>
      <label class="field-label" data-effect-for="vagustimDaytime">Any noticeable effect afterwards?<select name="vagustimDaytimeEffect"><option value="">Not answered</option><option>Noticeably better</option><option>Slightly better</option><option>No noticeable change</option><option>Felt worse</option><option>Not sure</option></select></label>
      <label class="check-row"><input name="vagustimEvening" type="checkbox" /><span><strong>Vagustim evening</strong></span></label>
    </section>
    <div class="capacity-section-heading">
      <p id="v2-autosave-status" class="autosave-status" aria-live="polite">Autosaves as I go</p>
    </div>
  </form>

  <section class="form-section" id="v2-food-section">
    <h3>Meal photos</h3>
    <div class="meal-photo-actions">
      <button id="v2-food-library" type="button" class="secondary-button" aria-controls="v2-food-image">Choose existing photo</button>
      <button id="v2-food-take" type="button" class="secondary-button" aria-controls="v2-food-camera">Take new photo</button>
    </div>
    <input id="v2-food-image" type="file" accept="image/*" aria-label="Existing meal photo" hidden />
    <input id="v2-food-camera" type="file" accept="image/*" capture="environment" aria-label="New meal photo" hidden />
    <p id="v2-food-selected" class="field-helper" hidden></p>
    <img id="v2-food-preview" class="meal-preview" alt="Selected meal" hidden />
    <label class="field-label">Meal time<input id="v2-food-time" type="time" /></label>
    <details class="optional-details" data-optional-note><summary>Add a meal note</summary><label class="field-label">Meal note<textarea id="v2-food-note" rows="2" maxlength="2000" placeholder="Ingredients or portion details"></textarea></label></details>
    <button id="v2-food-save" type="button" class="primary-button">Save meal photo</button>
    <p id="v2-food-status" role="status" aria-live="polite"></p>
    <button type="button" class="text-button" data-open-dialog="capacity-settings-dialog" data-dialog-target="photo-settings">Photo settings</button>
    <div id="v2-meal-list" class="meal-list"></div>
  </section>

</section>
