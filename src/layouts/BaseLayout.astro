---
import "../styles/global.css";

interface Props {
  title: string;
  active: "today" | "history" | "insights" | "export";
}

const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: "Today", key: "today" },
  { href: `${base}history`, label: "History", key: "history" },
  { href: `${base}insights`, label: "Insights", key: "insights" },
  { href: `${base}export`, label: "Export", key: "export" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Private local-first capacity tracking journal." />
    <title>{title} | Capacity Tracker</title>
  </head>
  <body>
    <header class="app-header">
      <div>
        <p class="eyebrow">Private local journal</p>
        <h1>Capacity Tracker</h1>
      </div>
      <nav class="top-nav" aria-label="Main navigation">
        {
          links.map((link) => (
            <a href={link.href} aria-current={active === link.key ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
