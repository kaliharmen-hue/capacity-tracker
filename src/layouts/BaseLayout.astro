---
import "../styles/global.css";

interface Props {
  title: string;
  active: "daily" | "timeline" | "weekly" | "monthly" | "pmdd" | "clinical" | "experiments" | "export";
}

const { title, active } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const manifestHref = `${base}manifest.webmanifest`;
const icon192 = `${base}icons/icon-192.svg`;

const links = [
  { href: base, label: "Daily Log", key: "daily" },
  { href: `${base}timeline/`, label: "Capacity Timeline", key: "timeline" },
  { href: `${base}history/`, label: "Weekly Review", key: "weekly" },
  { href: `${base}insights/`, label: "Monthly Insights", key: "monthly" },
  { href: `${base}pmdd/`, label: "PMDD Review", key: "pmdd" },
  { href: `${base}clinical/`, label: "Clinical Patterns", key: "clinical" },
  { href: `${base}experiments/`, label: "Experiments", key: "experiments" },
  { href: `${base}export/`, label: "Export", key: "export" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Private local-first personal operating system." />
    <meta name="theme-color" content="#3f6f63" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Personal OS" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href={manifestHref} />
    <link rel="icon" href={icon192} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={icon192} />
    <title>{title} | Personal Operating System</title>
  </head>
  <body>
    <header class="app-header">
      <div>
        <p class="eyebrow">Private local journal</p>
        <h1>Personal Operating System</h1>
      </div>
      <nav class="top-nav" aria-label="Main navigation">
        {
          links.map((link) => (
            <a href={link.href} aria-current={active === link.key ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      if ("serviceWorker" in navigator) {
        const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(`${base}sw.js?v=12`).then((registration) => registration.update()).catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
