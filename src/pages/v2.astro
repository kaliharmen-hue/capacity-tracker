---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Personal OS V2" active="v2">
  <section class="page-heading">
    <div>
      <p class="eyebrow">Personal OS V2</p>
      <h2>A smaller daily check-in</h2>
    </div>
    <p class="soft-copy">This is being developed alongside the original tracker. Your historical records remain in the existing Daily Log.</p>
  </section>

  <form id="v2-entry-form" class="tracker-form">
    <div class="sticky-actions">
      <label class="date-control">
        <span>Date</span>
        <input id="v2-entry-date" name="date" type="date" />
      </label>
      <div class="save-cluster">
        <p id="v2-autosave-status" class="autosave-status" aria-live="polite">Autosaves as I go</p>
        <button id="v2-complete-button" type="button" class="primary-button">Mark daily log complete</button>
      </div>
    </div>

    <section class="form-section">
      <h3>Daily measures</h3>
      <p class="section-prompt">These new V2 scores are separate from the original tracker: 0 means none and 10 means worst.</p>
      <label class="field-label">Physical fatigue (0-10)<span class="field-helper">How physically fatigued did I feel today? 0 = none, 10 = extreme fatigue.</span><input name="physicalFatigue" type="number" min="0" max="10" step="1" /></label>
      <label class="field-label">Cognitive difficulty (0-10)<span class="field-helper">How difficult did thinking feel today, including brain fog or a swimming-head sensation? 0 = none, 10 = severe difficulty.</span><input name="cognitiveDifficulty" type="number" min="0" max="10" step="1" /></label>
      <label class="field-label">How much did this affect what I could manage today?<select name="functionalImpact"><option value="">Not answered</option><option>No impact</option><option>Managed with extra effort</option><option>Reduced or postponed activities</option><option>Unable to manage essential activities</option></select></label>
      <label class="field-label">Optional notes<textarea name="notes" rows="3"></textarea></label>
    </section>

    <section class="form-section">
      <h3>Protocols</h3>
      <p class="section-prompt">Only tick a session when I completed it. A day with no V2 log remains unknown, not a missed session.</p>
      <label class="check-row"><input name="bioLightFullSpectrum" type="checkbox" /><span><strong>BioLight full-spectrum light therapy</strong><small>07:00 for 60 minutes, approximately 44 cm from the panel.</small></span></label>
      <label class="field-label compact-field">Brightness setting (optional)<input name="bioLightBrightness" type="text" placeholder="For example, setting 8" /></label>
      <label class="field-label" data-effect-for="bioLightFullSpectrum">Any noticeable effect afterwards?<select name="bioLightEffect"><option value="">Not answered</option><option>Noticeably better</option><option>Slightly better</option><option>No noticeable change</option><option>Felt worse</option><option>Not sure</option></select></label>
      <label class="check-row"><input name="bioLightInfrared" type="checkbox" /><span><strong>BioLight infrared session</strong><small>Following full-spectrum exposure.</small></span></label>
      <label class="check-row"><input name="vagustimDaytime" type="checkbox" /><span><strong>Vagustim V2 Standard cognitive programme</strong><small>Approximately 15 minutes during the day, with flexible timing.</small></span></label>
      <label class="field-label" data-effect-for="vagustimDaytime">Any noticeable effect afterwards?<select name="vagustimDaytimeEffect"><option value="">Not answered</option><option>Noticeably better</option><option>Slightly better</option><option>No noticeable change</option><option>Felt worse</option><option>Not sure</option></select></label>
      <label class="check-row"><input name="vagustimEvening" type="checkbox" /><span><strong>Vagustim V2 Standard AI programme</strong><small>Approximately 15 minutes before sleep. The important outcome is the subsequent night's sleep.</small></span></label>
    </section>
  </form>

  <section class="form-section" id="v2-food-section">
    <h3>Optional meal photo</h3>
    <p class="section-prompt">I can photograph or choose a meal and ask AI for a cautious estimate. The photo is sent only after I give consent, and the confirmed meal is saved without retaining the image by default.</p>
    <label class="field-label">Meal photo<input id="v2-food-image" type="file" accept="image/*" capture="environment" /></label>
    <label class="field-label">Meal time<input id="v2-food-time" type="time" /></label>
    <label class="field-label">Optional meal note<textarea id="v2-food-note" rows="2" placeholder="Anything I already know about this meal"></textarea></label>
    <label class="check-row"><input id="v2-food-consent" type="checkbox" /><span><strong>I consent to sending this image for one-off analysis</strong><small>The image is processed by the configured AI service and is not stored by this app after analysis.</small></span></label>
    <button id="v2-food-analyse" type="button" class="secondary-button">Analyse meal photo</button>
    <p id="v2-food-status" class="autosave-status" aria-live="polite"></p>
    <div id="v2-food-result" class="food-result" hidden>
      <p class="field-helper">Review and correct the estimate before saving it. This is an estimate, not a precise nutritional measurement.</p>
      <label class="field-label">Likely ingredients<textarea id="v2-food-ingredients" rows="3"></textarea></label>
      <label class="field-label">Portion description<textarea id="v2-food-portions" rows="2"></textarea></label>
      <div class="food-number-grid">
        <label class="field-label">Calories<input id="v2-food-calories" type="number" min="0" step="1" /></label>
        <label class="field-label">Protein (g)<input id="v2-food-protein" type="number" min="0" step="0.1" /></label>
        <label class="field-label">Carbohydrate (g)<input id="v2-food-carbs" type="number" min="0" step="0.1" /></label>
        <label class="field-label">Fat (g)<input id="v2-food-fat" type="number" min="0" step="0.1" /></label>
      </div>
      <p id="v2-food-confidence" class="field-helper"></p>
      <button id="v2-food-confirm" type="button" class="primary-button">Confirm and save meal</button>
    </div>
    <div id="v2-meal-list" class="meal-list" aria-live="polite"></div>
  </section>

  <script src="../scripts/v2.ts"></script>
</BaseLayout>
