---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title="Personal OS V2" active="capacity">
  <p><a id="v2-moved" class="secondary-button" href={base + "capacity/#v2-check-in"}>Open Personal OS V2 in Capacity Building</a></p>
  <script>
    const link = document.querySelector<HTMLAnchorElement>("#v2-moved")!;
    const destination = new URL(link.href);
    destination.search = location.search;
    link.href = destination.href;
    location.replace(destination);
  </script>
</BaseLayout>
