---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Today" active="today">
  <section class="page-heading">
    <div>
      <p class="eyebrow">Daily check-in</p>
      <h2>What is true today?</h2>
    </div>
    <p class="soft-copy">A gentle tracker for capacity, regulation, load, and recovery.</p>
  </section>

  <form id="entry-form" class="tracker-form">
    <div class="sticky-actions">
      <label class="date-control">
        <span>Date</span>
        <input id="entry-date" name="date" type="date" />
      </label>
      <div class="save-cluster">
        <p id="autosave-status" class="autosave-status" aria-live="polite">Autosaves as I go</p>
        <a id="entry-export-link" class="primary-button" href={`${base}export/`}>Export</a>
      </div>
    </div>
    <div id="form-sections"></div>
  </form>

  <script src="../scripts/today.ts"></script>
</BaseLayout>
