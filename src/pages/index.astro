---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title="Capacity Building" active="capacity">
  <p><a id="app-start" class="secondary-button" href={base + "capacity/"}>Open Capacity Building</a></p>
  <script is:inline>
    const destination = new URL(document.getElementById("app-start").href);
    const current = new URL(location.href);
    // Older date links were bookmarks to the original Daily Log.
    const target = current.searchParams.has("date") ? new URL("../daily/", destination) : destination;
    target.search = current.search;
    target.hash = current.hash;
    location.replace(target);
  </script>
</BaseLayout>
