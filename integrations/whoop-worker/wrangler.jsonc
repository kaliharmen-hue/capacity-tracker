{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-os-whoop",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "vars": {
    "APP_ORIGIN": "https://kaliharmen-hue.github.io/capacity-tracker/"
  },
  "kv_namespaces": [
    {
      "binding": "WHOOP_AUTH",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
